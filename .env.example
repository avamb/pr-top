# PR-TOP Environment Configuration
# Copy this file to .env and fill in the values

# === Domain & SSL (for production Nginx reverse proxy) ===
# DOMAIN=prtop.example.com
# SSL_EMAIL=admin@example.com  # Let's Encrypt certificate email

# === Security (REQUIRED - change these in production!) ===
JWT_SECRET=change-me-to-a-random-64-char-string
ENCRYPTION_MASTER_KEY=change-me-to-a-random-64-char-string
BOT_API_KEY=change-me-to-a-random-api-key
# In production (NODE_ENV=production) the backend REFUSES TO START when any of the
# three secrets above is unset, shorter than 16 chars, or equal to a dev default /
# the placeholder values in this file (src/backend/src/utils/secretsGuard.js).
# Emergency override ONLY if production data was already encrypted with a default
# ENCRYPTION_MASTER_KEY and must stay readable until re-keyed: logs a loud error
# instead of exiting. Leave unset/false otherwise.
ALLOW_INSECURE_DEFAULT_SECRETS=false
# Dedicated HMAC key for signed public links (falls back to JWT_SECRET; the
# backend warns at startup in production when unset)
SIGNED_LINK_SECRET=

# === Superadmin Credentials ===
SUPERADMIN_EMAIL=admin@pr-top.com
SUPERADMIN_PASSWORD=ChangeThisPassword123!

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
BOT_USERNAME=YourBotUsername  # Bot username (without @) for deep link invites: t.me/BOT_USERNAME?start=CODE
# Bot liveness file, touched every 30 s while Telegram polling is healthy (container healthcheck)
BOT_HEARTBEAT_FILE=/tmp/bot-heartbeat

# === Stripe Payments (optional - leave empty to disable) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === AI / Transcription (optional) ===
# Provider selection (default: openai)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI (default provider)
AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1  # custom endpoint (optional)

# Anthropic (optional — set key to use Claude models)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1  # custom endpoint (optional)
# To use: set AI_PROVIDER=anthropic, AI_MODEL=claude-3-haiku or claude-3.5-sonnet

# Google Gemini (optional — set key to use Gemini models)
GOOGLE_AI_API_KEY=
# To use: set AI_PROVIDER=google, AI_MODEL=gemini-1.5-flash or gemini-1.5-pro

# OpenRouter (optional — unified API for any model)
OPENROUTER_API_KEY=
# To use: set AI_PROVIDER=openrouter, AI_MODEL=deepseek/deepseek-chat or any slug

# Transcription
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_API_URL=https://api.openai.com/v1  # custom endpoint (optional)
# TRANSCRIPTION_LANGUAGE=  # auto-detect if empty
# FFMPEG_PATH=  # ffmpeg binary override (default: ffmpeg from PATH; the Docker image bundles it)
# FFMPEG_TIMEOUT_MS=900000  # max time for one ffmpeg conversion of a long recording (default 15 min)

# === Email / SMTP (optional - leave empty to disable, emails logged to console) ===
# Recommended: Brevo (brevo.com) — free tier: 300 emails/day
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<your-brevo-login-email>
# SMTP_PASS=<your-brevo-smtp-key>    # SMTP Key (not API Key!) from Settings → SMTP & API
# Also configure DNS for deliverability:
#   SPF:   TXT  @           v=spf1 include:sendinblue.com ~all
#   DKIM:  TXT  (from Brevo dashboard)
#   DMARC: TXT  _dmarc      v=DMARC1; p=quarantine
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PR-TOP <noreply@pr-top.com>

# === Scheduler (optional) ===
SCHEDULER_ENABLED=true

# === Backups (optional) ===
# Backups are gzip + AES-256-GCM files (<dir>/prtop_backup_*.db.gz.enc) encrypted
# with a key derived from ENCRYPTION_MASTER_KEY. Older AES-CBC backups still restore.
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=30
BACKUP_CRON=0 3 * * *
# Off-host copy: shell command run after every backup, with the backup file path
# appended as the last argument (also in $BACKUP_FILE). Runs in the background,
# never blocks or fails the backup; the result is logged ([BACKUP] Off-site copy ...).
# Its environment is scrubbed: every variable whose name contains KEY, SECRET, TOKEN,
# PASS, PASSWORD or PEPPER (case-insensitive), plus STRIPE_*, DATABASE_URL, SMTP_USER
# and SUPERADMIN_EMAIL, is removed. Exception (passed through for the copy tool's own
# credentials): names starting with RCLONE_, AWS_, SSH_, B2_ or GOOGLE_APPLICATION_CREDENTIALS.
# Off-site copies are not re-sent after a key rotation (see the key-rotation runbook).
# The tool must exist in the backend image (rclone/scp are NOT installed by default).
# Tools that want the destination last can be wrapped; with `sh -c '...'` the appended
# path arrives as $0:
#   BACKUP_OFFSITE_COMMAND=sh -c 'rclone copy --config /app/data/rclone.conf "$0" offsite:prtop-backups'
#   BACKUP_OFFSITE_COMMAND=sh -c 'scp -i /app/data/backup_ed25519 -o BatchMode=yes "$0" backup@host:/srv/prtop/'
# Copies made before a master-key rotation stay encrypted with the old key.
BACKUP_OFFSITE_COMMAND=
# Kill the off-site command after this many ms (default 600000 = 10 min)
BACKUP_OFFSITE_TIMEOUT_MS=600000

# === Encryption master-key rotation (optional; see docs/troubleshooting/key-rotation-runbook.md) ===
# Leave all four unset for normal operation (one master key for every key version).
# To rotate: put the NEW secret in ENCRYPTION_MASTER_KEY, set ENCRYPTION_MASTER_KEY_VERSION
# to (highest existing key version + 1, shown in the superadmin dashboard), and move the OLD
# secret to ENCRYPTION_MASTER_KEY_PREVIOUS (decrypt-only). Then run the re-encryption job
# from the dashboard and remove ENCRYPTION_MASTER_KEY_PREVIOUS once it reports nothing left.
# The backend refuses to start when PREVIOUS is set without a higher VERSION.
ENCRYPTION_MASTER_KEY_VERSION=
ENCRYPTION_MASTER_KEY_PREVIOUS=
# First key version the previous secret serves (default 1)
ENCRYPTION_MASTER_KEY_PREVIOUS_VERSION=
# Key check: the backend refuses to encrypt when the configured key does not open
# data already stored under the active key version (wrong key / wrong VERSION).
# Set to "warn" ONLY as an emergency override for a false positive (logs instead).
ENCRYPTION_KEY_CHECK=enforce

# === Umami Web Analytics (optional - privacy-first, cookieless, GDPR-compliant) ===
# Umami tracks landing page visitors, conversions, and traffic sources.
# After first launch, log in to Umami dashboard, create a website, and paste the website ID below.
UMAMI_WEBSITE_ID=
# Frontend tracking script (Vite env var — used in index.html)
VITE_UMAMI_WEBSITE_ID=
# Umami dashboard URL (used for SuperAdmin link; in production use https://app.pr-top.com)
UMAMI_DASHBOARD_URL=https://app.pr-top.com
# Umami database credentials (for Docker Compose)
# PRODUCTION: docker-compose.yml falls back to the insecure defaults below when
# these are unset (so local `docker compose up` works). In Dokploy you MUST set
# UMAMI_APP_SECRET (random 32+ chars) and UMAMI_DB_PASSWORD, and keep
# UMAMI_DATABASE_URL in sync with that password
# (postgresql://<UMAMI_DB_USER>:<UMAMI_DB_PASSWORD>@umami-db:5432/umami).
UMAMI_DATABASE_URL=postgresql://umami:umami@umami-db:5432/umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=umami
UMAMI_APP_SECRET=replace-me-with-a-random-string
# Default Umami admin credentials (change after first login!)
# UMAMI_ADMIN_USER=admin
# UMAMI_ADMIN_PASSWORD=umami

# === Logging ===
LOG_LEVEL=info

# --- Process resilience (backend container) ---------------------------------
# In-process memory watchdog: exit (-> container restart) once RSS crosses
# this many MB. 0 disables. Keep below the compose mem_limit (1536m).
MEMORY_WATCHDOG_MAX_RSS_MB=1024
# Container healthcheck (src/backend/healthcheck.sh): kill node after this
# many consecutive failed liveness probes (15s apart), but never during the
# first HEALTHCHECK_START_GRACE seconds of a process' life.
HEALTHCHECK_MAX_FAILURES=4
HEALTHCHECK_START_GRACE=300

# === Anti-bot protection (optional - Cloudflare Turnstile) ===
# Leave TURNSTILE_SECRET empty to disable Turnstile verification.
# Dev keys (always pass/fail): site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (pass) or 2x0000000000000000000000000000000AA (fail).
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
# Enable/disable honeypot and timing checks (independent of Turnstile)
ANTIBOT_ENABLED=true
# Minimum time (ms) form must be displayed before submission; 0 disables
ANTIBOT_MIN_FORM_MS=3000
# Rate limiting (per IP per hour)
REGISTER_RATE_LIMIT_MAX=5
LOGIN_CODE_RATE_LIMIT_MAX=10
# Bot API (/api/bot/*) limit per Telegram user per 15 minutes for requests with a
# valid x-bot-api-key (all bot traffic shares one container IP, so it is exempt
# from the global per-IP limiter). POST /api/bot/sos is never limited.
BOT_RATE_LIMIT_MAX=6000
# Per-account password lockout: this many wrong passwords within the window lock
# PASSWORD login for that account for the lock duration (minutes). The answer is
# the same generic "invalid credentials"; login by email code stays available.
LOGIN_LOCK_MAX_FAILURES=10
LOGIN_LOCK_WINDOW_MIN=15
LOGIN_LOCK_DURATION_MIN=15
# JSON body size limits: every API route / the internal bot API only (base64 media)
JSON_BODY_LIMIT=1mb
# GET /api/csrf-token per IP per 15 minutes (production default 120)
CSRF_TOKEN_RATE_LIMIT_MAX=120
BOT_JSON_BODY_LIMIT=30mb
# Rate limiters trust the CF-Connecting-IP header. Set to true ONLY after the origin
# accepts traffic from Cloudflare exclusively (host firewall on 80/443 or Authenticated
# Origin Pulls); otherwise the header is spoofable. In production the backend logs a
# startup warning while this is not true.
ORIGIN_LOCKED=false
# Pepper for login code hashing (required in production; defaults to JWT_SECRET if empty)
LOGIN_CODE_PEPPER=
# Login code TTL (minutes)
LOGIN_CODE_TTL_MIN=10
# Email verification gate: set to false to disable blocking unverified users
EMAIL_VERIFICATION_GATE=true
# Email verification link TTL (hours)
EMAIL_VERIFICATION_TTL_H=48
# Auto-delete unverified accounts older than this many days with no activity
UNVERIFIED_CLEANUP_DAYS=7
# Dry-run mode for unverified account cleanup (set to false after reviewing [SCHEDULER] logs to actually delete)
UNVERIFIED_CLEANUP_DRY_RUN=true

# === Data retention (daily job at 04:00, services/retentionService.js) ===
# Public assistant: delete public-chat assistant_messages, anonymous conversations and anonymous viewer_sessions older than this many days (sessions with an email/user keep their row, only ip/user_agent/fingerprint are nulled)
ASSISTANT_RETENTION_DAYS=90
# Delete cached assistant answers not used for this many days (seeded FAQ answers are never deleted)
ASSISTANT_CACHE_RETENTION_DAYS=180
# Delete ai_usage_log rows older than this many days
AI_USAGE_RETENTION_DAYS=400
# Delete audit_logs rows older than this many days
AUDIT_LOG_RETENTION_DAYS=730
# Delete stripe_webhook_events (webhook idempotency ledger) older than this many days
STRIPE_WEBHOOK_EVENT_RETENTION_DAYS=90
# true = only log how many rows would be deleted, delete nothing
RETENTION_DRY_RUN=false

# === Public assistant (anonymous landing-page chat) ===
# Max NEW chat sessions one IP may start per rolling 24h. Applied only when a new
# session would be created (never to an existing session / lead). CF-Connecting-IP is
# trusted for the IP, so keep the origin firewalled to Cloudflare (see ORIGIN_LOCKED).
PUBLIC_ASSISTANT_IP_DAILY_MAX=50
# IP-independent caps over a rolling 24h; when hit, visitors get a "try again later" reply
PUBLIC_ASSISTANT_GLOBAL_DAILY_SESSIONS=2000
PUBLIC_ASSISTANT_GLOBAL_DAILY_MESSAGES=10000
# Monthly USD budget for public-chat LLM calls (logged in ai_usage_log as operation
# 'public_assistant', therapist_id 0). 0 = unlimited. The platform-wide AI limit applies too.
PUBLIC_ASSISTANT_MONTHLY_LIMIT_USD=0

# === Dev & Testing (NODE_ENV !== 'production' only) ===
# Echo secrets in API responses for automated tests (NEVER in production)
# Allows tests to read dev_verification_token, dev_code, dev_link_token from response body
# (also logs the password-reset link to the backend log)
AUTH_DEV_ECHO=false
# /api/dev/* helpers (seed data, set-role, raw SELECT, ...) are mounted only when
# NODE_ENV is 'development' or 'test', or when this is true — and NEVER when
# NODE_ENV=production. Keep false on any shared/staging host.
ENABLE_DEV_ENDPOINTS=false

# === Database ===
# Enforce SQLite foreign keys at runtime (ON DELETE CASCADE etc.). Production has
# effectively always run with them OFF, and system audit rows (actor_id=0) plus
# anonymous assistant conversations (therapist_id=0) rely on that. Leave false
# until those sentinels and existing orphan rows are cleaned up.
DB_ENFORCE_FOREIGN_KEYS=false
